{
    "name": "appnave/nave-crm-iss",
    "description": "This is my package IssCrm",
    "keywords": [
        "bildvitta",
        "laravel",
        "iss-crm"
    ],
    "homepage": "https://github.com/appnave/nave-crm-iss",
    "license": "MIT",
    "authors": [
        {
            "name": "App Nave",
            "email": "contato@nave.app.br",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "spatie/laravel-package-tools": "^1.4.3",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "brianium/paratest": "^6.2",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^5.3",
        "orchestra/testbench": "^6.15",
        "phpunit/phpunit": "^9.3",
        "spatie/laravel-ray": "^1.23",
        "vimeo/psalm": "^4.8"
    },
    "autoload": {
        "psr-4": {
            "Bildvitta\\IssCrm\\": "src",
            "Bildvitta\\IssCrm\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bildvitta\\IssCrm\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "./vendor/bin/testbench package:test --parallel --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "check-style": [
            "vendor/bin/pint --test"
        ],
        "fix-style": [
            "vendor/bin/pint"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bildvitta\\IssCrm\\IssCrmServiceProvider"
            ],
            "aliases": {
                "IssCrm": "Bildvitta\\IssCrm\\IssCrmFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
